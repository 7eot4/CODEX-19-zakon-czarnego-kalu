<!doctype html><html lang="pl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{t093}}</title><style>*{box-sizing:border-box}body{background:#0c0e0f;color:#e8e6e0;font:14px Arial,sans-serif;margin:30px}a{color:inherit}.controls{max-width:800px;margin:0 auto 35px}h1{font:36px Georgia,serif}label{display:block;margin:14px 0}input{padding:9px;border:1px solid #aaa;max-width:100%}button{padding:12px 20px;background:#1b2022;color:#e8e6e0;border:0;cursor:pointer}.sheet{display:grid;grid-template-columns:repeat(2,85mm);gap:8mm;justify-content:center}.card{width:85mm;height:55mm;background:#1b2022;color:#e8e6e0;padding:6mm;position:relative;overflow:hidden;print-color-adjust:exact;-webkit-print-color-adjust:exact}.card>small{font-size:6pt;letter-spacing:1.3px}.card h2{font:18pt/1.1 Georgia,serif;margin:4mm 0}.card p{font-size:7pt;line-height:1.6;margin:0}.card img{filter:grayscale(1);position:absolute;width:27mm;height:27mm;right:4mm;top:11mm;border-radius:50%}.card h2{max-width:45mm}.back{background:#e8e6e0;color:#1b2022;border:1px solid #b8b09d}.back h2{font-size:15pt;max-width:none}.back p{max-width:65mm}.url{font-size:5.5pt!important;overflow-wrap:anywhere;margin-top:3mm!important;color:#526977}.name{font-weight:bold;font-size:8pt!important}.note{font-size:11px;line-height:1.7}@page{size:A4;margin:15mm}@media print{body{margin:0;background:white}.controls{display:none}.sheet{gap:5mm}.card{break-inside:avoid}}@media screen and (max-width:700px){.sheet{grid-template-columns:85mm;justify-content:start}body{margin:15px}}@media screen and (max-width:380px){.sheet{grid-template-columns:minmax(0,85mm)}.card{width:100%;max-width:85mm}.card h2{font-size:16pt;max-width:36mm}.card img{width:24mm;height:24mm;right:3mm;top:13mm}.back h2{max-width:none;font-size:15pt}.card>small{letter-spacing:.6px}.url{font-size:5pt!important}input{font-size:16px}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}</style></head><body><div class="controls"><a href="index.html#insygnia">{{t094}}</a><h1>{{t095}}</h1><p>{{t096}}</p><label>{{t097}} <input id="name" maxlength="28" placeholder="{{t098}}"></label><label>{{t099}} <input id="role" maxlength="40" placeholder="{{t100}}"></label><button id="print">{{t101}}</button><p class="note">{{t102}}</p></div><main class="sheet"><section class="card"><small>{{t103}}</small><h2>ZAKON<br>CZARNEGO<br>KAŁU</h2><img src="assets/logo.png" alt="{{t104}}"><p>{{t105}}<br>{{t106}}</p></section><section class="card back"><small>{{t107}}</small><h2>{{t008}}<br>{{t009}}</h2><p>{{t108}}<br>{{t109}}</p><p class="url">7eot4.github.io/CODEX-19-zakon-czarnego-kalu/</p></section><section class="card"><small>{{t075}}</small><h2>ZAKON<br>CZARNEGO<br>KAŁU</h2><img src="assets/logo.png" alt="{{t104}}"><p class="name" id="display-name">{{t098}}</p><p id="display-role">{{t100}}</p></section><section class="card back"><small>{{t110}}</small><h2>{{t078}}<br>{{t111}}</h2><p>{{t112}}<br>{{t113}}</p><p class="url">7eot4.github.io/CODEX-19-zakon-czarnego-kalu/</p></section></main><script>for(const id of ['name','role'])document.getElementById(id).addEventListener('input',e=>document.getElementById('display-'+id).textContent=e.target.value||e.target.placeholder);document.getElementById('print').addEventListener('click',()=>window.print());</script></body></html>
